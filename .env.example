# Copie para .env e ajuste. Todos os valores abaixo já são os padrões do docker-compose.

# --- Banco ---
POSTGRES_PASSWORD=sentinela
DB_PORT=5432

# --- API ---
# Troque em qualquer ambiente fora da sua máquina (mínimo 32 caracteres aleatórios).
JWT_SECRET=dev-secret-change-me-in-production-0123456789
# E-mail institucional que recebe cada nova ocorrência (no dev, cai no Mailpit).
PREFECTURE_EMAIL=vigilancia@prefeitura.test
PUBLIC_WEB_URL=http://localhost:5173
# Latitude de referência da grade de privacidade (~100 m). Use a do município e não mude depois.
PRIVACY_GRID_REF_LAT=-16.72
# Área atendida "min_lon,min_lat,max_lon,max_lat". Registros fora dela são recusados e o mapa
# fica preso a ela. Padrão: município de Montes Claros (MG), relação OSM 314620. Vazio = sem limite.
SERVICE_AREA_BBOX=-44.2107,-17.1458,-43.6665,-16.0845
SERVICE_AREA_NAME=Montes Claros (MG)
# Relação OSM do município: a importação de escolas, creches e unidades de saúde usa o contorno real.
SERVICE_AREA_OSM_RELATION=314620

# --- Grupo de mensagens do setor (Telegram) ---
# none: desligado | telegram: bot real | email: simula o grupo no Mailpit (desenvolvimento).
# Casos críticos vão na hora; o resto vai no resumo diário (python -m app.cli send-digest).
MESSAGING_PROVIDER=email
# Token do bot (BotFather) e id do grupo. Nunca versione o token.
TELEGRAM_BOT_TOKEN=
MESSAGING_CHAT_ID=vigilancia-endemias

# --- Seed de desenvolvimento ---
# "dev" cria tipos, coeficientes, usuários de teste e ocorrências fictícias ao subir a API.
# Aceita e-mails @*.test no cadastro (só desenvolvimento).
ALLOW_TEST_EMAIL_DOMAINS=true
SEED_ON_START=dev
SEED_FAKE_COUNT=60
SEED_CENTER=-16.7207,-43.8660
# Senha dos usuários de teste: morador@, agente@, gestor@, vizinho1@ e vizinha2@sentinela.test
SEED_PASSWORD=sentinela123

# --- Web (mapa) ---
# tile.openstreetmap.org só para desenvolvimento: a política de uso não permite tráfego pesado.
# Em produção, aponte para um provedor de tiles ou servidor próprio.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Se usar outro provedor, inclua a atribuição dele; a do OpenStreetMap é mantida sempre.
VITE_TILE_ATTRIBUTION=
VITE_MAP_CENTER=-16.7207,-43.8660
VITE_MAP_ZOOM=14
